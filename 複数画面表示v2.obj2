--information:複数の動画を比較のためなどに配置しやすくするスクリプト。
--file@movie1:動画1
--file@movie2:動画2
--file@movie3:動画3
--file@movie4:動画4
--group:動画5~9,false
--file@movie5:動画5
--file@movie6:動画6
--file@movie7:動画7
--file@movie8:動画8
--file@movie9:動画9
--group
--track@common_lr:左右削減,0,100,0,1
--track@common_ub:上下削減,0,100,0,1
--group:個別削減,false
--track@clip_l:左削減,0,100,0,1
--track@clip_r:右削減,0,100,0,1
--track@clip_u:上削減,0,100,0,1
--track@clip_d:下削減,0,100,0,1
--group
--check@fill:削減部分に合わせて動画を引き延ばす,1
--select@arrangement:表示タイプ=0,交互に並べる=0,横に並べる=1,縦に並べる=2,1つ目縦いっぱい残り横=3,1つ目横いっぱい残り横=4,2つ目まで縦いっぱい残り横=5,2つ目まで横いっぱい残り横=6
--track@line:分割ライン,0,500,1,1
--track@line_w:分割ライン横,0,500,0,1
--track@line_h:分割ライン縦,0,500,0,1
--color@line_col:分割ライン色,0xffffff
--check@line_avoid:分割ラインを避けて動画を配置する,0

-- forで使う用の配列
local movies = {movie1, movie2, movie3, movie4, movie5, movie6, movie7, movie8, movie9}
-- loadで読み込む用の配列
local using_movies = {}

-- 指定された動画の数を判定した数値をsumに格納
local sum = 0
for i = 1, #movies do
    if movies[i] and movies[i] ~= "" then
        sum = sum + 1
        using_movies[sum - 1] = movies[i]
    end
end

-- 画面サイズの横と縦を変数に代入
local w,h = obj.screen_w,obj.screen_h

-- 描画先を仮想バッファに指定
obj.setoption("drawtarget","tempbuffer",w,h)

-- 本処理
if sum ~= 0 then
    -- 各動画の位置とサイズを格納するテーブル
    local rects = {}
    
    if arrangement == 0 then
        -- 0: 交互に並べる
        local cols, rows
        if sum <= 1 then
            cols, rows = 1, 1
        elseif sum == 2 then
            cols, rows = 2, 1
        elseif sum <= 4 then
            cols, rows = 2, 2
        elseif sum <= 6 then
            cols, rows = 3, 2
        else
            cols, rows = 3, 3
        end
        
        local cell_w = w / cols
        local cell_h = h / rows
        for i = 1, sum do
            local c = (i - 1) % cols
            local r = math.floor((i - 1) / cols)
            rects[i] = {
                x = -w/2 + (c + 0.5) * cell_w,
                y = -h/2 + (r + 0.5) * cell_h,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 1 then
        -- 1: 横に並べる
        local cell_w = w / sum
        local cell_h = h
        for i = 1, sum do
            rects[i] = {
                x = -w/2 + (i - 0.5) * cell_w,
                y = 0,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 2 then
        -- 2: 縦に並べる
        local cell_w = w
        local cell_h = h / sum
        for i = 1, sum do
            rects[i] = {
                x = 0,
                y = -h/2 + (i - 0.5) * cell_h,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 3 then
        -- 3: 1つ目縦いっぱい残り横
        if sum <= 1 then
            rects[1] = { x = 0, y = 0, w = w, h = h }
        else
            rects[1] = { x = -w/4, y = 0, w = w/2, h = h }
            local rem = sum - 1
            local cell_w = w / 2
            local cell_h = h / rem
            for i = 2, sum do
                rects[i] = {
                    x = w/4,
                    y = -h/2 + (i - 1.5) * cell_h,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 4 then
        -- 4: 1つ目横いっぱい残り横
        if sum <= 1 then
            rects[1] = { x = 0, y = 0, w = w, h = h }
        else
            rects[1] = { x = 0, y = -h/4, w = w, h = h/2 }
            local rem = sum - 1
            local cell_w = w / rem
            local cell_h = h / 2
            for i = 2, sum do
                rects[i] = {
                    x = -w/2 + (i - 1.5) * cell_w,
                    y = h/4,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 5 then
        -- 5: 2つ目まで縦いっぱい残り横
        if sum <= 2 then
            local cell_w = w / 2
            rects[1] = { x = -w/4, y = 0, w = cell_w, h = h }
            rects[2] = { x = w/4, y = 0, w = cell_w, h = h }
        else
            rects[1] = { x = -w/3, y = 0, w = w/3, h = h }
            rects[2] = { x = 0, y = 0, w = w/3, h = h }
            local rem = sum - 2
            local cell_w = w / 3
            local cell_h = h / rem
            for i = 3, sum do
                rects[i] = {
                    x = w/3,
                    y = -h/2 + (i - 2.5) * cell_h,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 6 then
        -- 6: 2つ目まで横いっぱい残り横
        if sum <= 2 then
            local cell_h = h / 2
            rects[1] = { x = 0, y = -h/4, w = w, h = cell_h }
            rects[2] = { x = 0, y = h/4, w = w, h = cell_h }
        else
            rects[1] = { x = 0, y = -h/3, w = w, h = h/3 }
            rects[2] = { x = 0, y = 0, w = w, h = h/3 }
            local rem = sum - 2
            local cell_w = w / rem
            local cell_h = h / 3
            for i = 3, sum do
                rects[i] = {
                    x = -w/2 + (i - 2.5) * cell_w,
                    y = h/3,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    end

    -- 分割ラインを避ける処理
    if line_avoid == 1 and (line ~= 0 or line_w ~= 0 or line_h ~= 0) then
        local lw = line + line_w
        local lh = line + line_h
        local margin = 0.01
        for i = 1, sum do
            local r = rects[i]
            local left = r.x - r.w / 2
            local right = r.x + r.w / 2
            local top = r.y - r.h / 2
            local bottom = r.y + r.h / 2
            
            if left > -w/2 + margin then
                left = left + lw / 2
            end
            if right < w/2 - margin then
                right = right - lw / 2
            end
            if top > -h/2 + margin then
                top = top + lh / 2
            end
            if bottom < h/2 - margin then
                bottom = bottom - lh / 2
            end
            
            r.w = math.max(0, right - left)
            r.h = math.max(0, bottom - top)
            r.x = left + r.w / 2
            r.y = top + r.h / 2
        end
    end

    -- 動画のロードと描画
    for i = 1, sum do
        obj.load(using_movies[i - 1])
        local org_w, org_h = obj.w, obj.h
        
        -- クリッピング量の算出 (一律削減 / 2 + 個別削減。上限100)
        local clip_l_px = org_w * (math.min(100, (common_lr / 2) + clip_l) / 100)
        local clip_r_px = org_w * (math.min(100, (common_lr / 2) + clip_r) / 100)
        local clip_u_px = org_h * (math.min(100, (common_ub / 2) + clip_u) / 100)
        local clip_d_px = org_h * (math.min(100, (common_ub / 2) + clip_d) / 100)
        
        obj.effect("クリッピング", 
            "上", clip_u_px, 
            "下", clip_d_px, 
            "左", clip_l_px, 
            "右", clip_r_px, 
            "中心の位置を変更", 0
        )
        
        local target_w = rects[i].w
        local target_h = rects[i].h
        
        local new_w, new_h
        if fill == 1 then
            new_w = target_w
            new_h = target_h
        else
            local scale_w = 1 - ((clip_l_px + clip_r_px) / org_w)
            local scale_h = 1 - ((clip_u_px + clip_d_px) / org_h)
            new_w = target_w * scale_w
            new_h = target_h * scale_h
        end
        
        obj.effect("リサイズ", 
            "拡大率", 100.000, 
            "X", new_w, 
            "Y", new_h, 
            "補間なし", 0, 
            "ピクセル数でサイズ指定", 1
        )
        
        obj.draw(rects[i].x, rects[i].y)
    end

    -- 分割ラインの描画
    if line ~= 0 or line_w ~= 0 or line_h ~= 0 then
        local function draw_line(lx, ly, lw, lh)
            obj.load("figure", "四角形", line_col, 100)
            obj.effect("リサイズ", 
                "拡大率", 100.000, 
                "X", lw, 
                "Y", lh, 
                "補間なし", 0, 
                "ピクセル数でサイズ指定", 1
            )
            obj.draw(lx, ly)
        end

        if arrangement == 0 then
            local cols, rows
            if sum <= 1 then
                cols, rows = 1, 1
            elseif sum == 2 then
                cols, rows = 2, 1
            elseif sum <= 4 then
                cols, rows = 2, 2
            elseif sum <= 6 then
                cols, rows = 3, 2
            else
                cols, rows = 3, 3
            end
            local cell_w = w / cols
            local cell_h = h / rows
            for c = 1, cols - 1 do
                draw_line(-w/2 + c * cell_w, 0, line + line_w, h)
            end
            for r = 1, rows - 1 do
                draw_line(0, -h/2 + r * cell_h, w, line + line_h)
            end
        elseif arrangement == 1 then
            local cell_w = w / sum
            for c = 1, sum - 1 do
                draw_line(-w/2 + c * cell_w, 0, line + line_w, h)
            end
        elseif arrangement == 2 then
            local cell_h = h / sum
            for r = 1, sum - 1 do
                draw_line(0, -h/2 + r * cell_h, w, line + line_h)
            end
        elseif arrangement == 3 then
            if sum >= 2 then
                draw_line(0, 0, line + line_w, h)
                local rem = sum - 1
                local cell_h = h / rem
                for r = 1, rem - 1 do
                    draw_line(w/4, -h/2 + r * cell_h, w/2, line + line_h)
                end
            end
        elseif arrangement == 4 then
            if sum >= 2 then
                draw_line(0, 0, w, line + line_h)
                local rem = sum - 1
                local cell_w = w / rem
                for c = 1, rem - 1 do
                    draw_line(-w/2 + c * cell_w, h/4, line + line_w, h/2)
                end
            end
        elseif arrangement == 5 then
            if sum >= 3 then
                draw_line(-w/6, 0, line + line_w, h)
                draw_line(w/6, 0, line + line_w, h)
                local rem = sum - 2
                local cell_h = h / rem
                for r = 1, rem - 1 do
                    draw_line(w/3, -h/2 + r * cell_h, w/3, line + line_h)
                end
            end
        elseif arrangement == 6 then
            if sum >= 3 then
                draw_line(0, -h/6, w, line + line_h)
                draw_line(0, h/6, w, line + line_h)
                local rem = sum - 2
                local cell_w = w / rem
                for c = 1, rem - 1 do
                    draw_line(-w/2 + c * cell_w, h/3, line + line_w, h/3)
                end
            end
        end
    end

    obj.setoption("drawtarget","framebuffer")
    obj.load("tempbuffer")
    return
else
    obj.setoption("drawtarget","framebuffer")
    obj.load("tempbuffer")
    return
end