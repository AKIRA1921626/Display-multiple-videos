--information:複数の動画を比較のためなどに配置しやすくするスクリプト。v2とは少し使い方が違うので、どちらを使うかはお好みで。
--group:動画1,true
--file@movie1:動画1
--track@start_minuts1:開始秒数1,0,10000,0,0.01
--track@start_frame1:開始フレーム数1,0,10000,0,1
--track@end_minuts1:終了秒数1,0,10000,0,0.01
--track@end_frame1:終了フレーム数1,0,10000,0,1
--track@movie_speed1:再生速度1,0,800,100,1
--check@roop1:ループする1,1
--group
--group:動画2,true
--file@movie2:動画2
--track@start_minuts2:開始秒数2,0,10000,0,0.01
--track@start_frame2:開始フレーム数2,0,10000,0,1
--track@end_minuts2:終了秒数2,0,10000,0,0.01
--track@end_frame2:終了フレーム数2,0,10000,0,1
--track@movie_speed2:再生速度2,0,800,100,1
--check@roop2:ループする2,1
--group
--group:動画3,true
--file@movie3:動画3
--track@start_minuts3:開始秒数3,0,10000,0,0.01
--track@start_frame3:開始フレーム数3,0,10000,0,1
--track@end_minuts3:終了秒数3,0,10000,0,0.01
--track@end_frame3:終了フレーム数3,0,10000,0,1
--track@movie_speed3:再生速度3,0,800,100,1
--check@roop3:ループする3,1
--group
--group:動画4,true
--file@movie4:動画4
--track@start_minuts4:開始秒数4,0,10000,0,0.01
--track@start_frame4:開始フレーム数4,0,10000,0,1
--track@end_minuts4:終了秒数4,0,10000,0,0.01
--track@end_frame4:終了フレーム数4,0,10000,0,1
--track@movie_speed4:再生速度4,0,800,100,1
--check@roop4:ループする4,1
--group
--group:動画5,true
--file@movie5:動画5
--track@start_minuts5:開始秒数5,0,10000,0,0.01
--track@start_frame5:開始フレーム数5,0,10000,0,1
--track@end_minuts5:終了秒数5,0,10000,0,0.01
--track@end_frame5:終了フレーム数5,0,10000,0,1
--track@movie_speed5:再生速度5,0,800,100,1
--check@roop5:ループする5,1
--group
--group:動画6,true
--file@movie6:動画6
--track@start_minuts6:開始秒数6,0,10000,0,0.01
--track@start_frame6:開始フレーム数6,0,10000,0,1
--track@end_minuts6:終了秒数6,0,10000,0,0.01
--track@end_frame6:終了フレーム数6,0,10000,0,1
--track@movie_speed6:再生速度6,0,800,100,1
--check@roop6:ループする6,1
--group
--group:動画7,false
--file@movie7:動画7
--track@start_minuts7:開始秒数7,0,10000,0,0.01
--track@start_frame7:開始フレーム数7,0,10000,0,1
--track@end_minuts7:終了秒数7,0,10000,0,0.01
--track@end_frame7:終了フレーム数7,0,10000,0,1
--track@movie_speed7:再生速度7,0,800,100,1
--check@roop7:ループする7,1
--group
--group:動画8,false
--file@movie8:動画8
--track@start_minuts8:開始秒数8,0,10000,0,0.01
--track@start_frame8:開始フレーム数8,0,10000,0,1
--track@end_minuts8:終了秒数8,0,10000,0,0.01
--track@end_frame8:終了フレーム数8,0,10000,0,1
--track@movie_speed8:再生速度8,0,800,100,1
--check@roop8:ループする8,1
--group
--group:動画9,false
--file@movie9:動画9
--track@start_minuts9:開始秒数9,0,10000,0,0.01
--track@start_frame9:開始フレーム数9,0,10000,0,1
--track@end_minuts9:終了秒数9,0,10000,0,0.01
--track@end_frame9:終了フレーム数9,0,10000,0,1
--track@movie_speed9:再生速度9,0,800,100,1
--check@roop9:ループする9,1
--group
--track@common_lr:左右削減,0,100,0,1
--track@common_ub:上下削減,0,100,0,1
--group:個別削減,false
--track@clip_l:左削減,0,100,0,1
--track@clip_r:右削減,0,100,0,1
--track@clip_u:上削減,0,100,0,1
--track@clip_d:下削減,0,100,0,1
--group
--check@fill:削減部分に合わせて動画を引き延ばす,1
--select@arrangement:表示タイプ=0,交互に並べる=0,横に並べる=1,縦に並べる=2,1つ目縦いっぱい残り横=3,1つ目横いっぱい残り横=4,2つ目まで縦いっぱい残り横=5,2つ目まで横いっぱい残り横=6
--track@line:分割ライン,0,500,1,1
--track@line_w:分割ライン横,0,500,0,1
--track@line_h:分割ライン縦,0,500,0,1
--color@line_col:分割ライン色,0xffffff
--check@line_avoid:分割ラインを避けて動画を配置する,0

-- forで使う用の配列
local movies = {movie1, movie2, movie3, movie4, movie5, movie6, movie7, movie8, movie9}

-- 各動画の個別設定値のマッピングテーブル
local start_seconds_list = {
    start_minuts1, start_minuts2, start_minuts3, start_minuts4,
    start_minuts5, start_minuts6, start_minuts7, start_minuts8, start_minuts9
}
local start_frames_list = {
    start_frame1, start_frame2, start_frame3, start_frame4,
    start_frame5, start_frame6, start_frame7, start_frame8, start_frame9
}
local end_seconds_list = {
    end_minuts1, end_minuts2, end_minuts3, end_minuts4,
    end_minuts5, end_minuts6, end_minuts7, end_minuts8, end_minuts9
}
local end_frames_list = {
    end_frame1, end_frame2, end_frame3, end_frame4,
    end_frame5, end_frame6, end_frame7, end_frame8, end_frame9
}
local movie_speeds_list = {
    movie_speed1, movie_speed2, movie_speed3, movie_speed4,
    movie_speed5, movie_speed6, movie_speed7, movie_speed8, movie_speed9
}
local loops_list = {
    roop1, roop2, roop3, roop4,
    roop5, roop6, roop7, roop8, roop9
}

-- loadで読み込む用の配列
local using_movies = {}

-- 指定された動画の数を判定した数値をsumに格納
local sum = 0
for i = 1, #movies do
    if movies[i] and movies[i] ~= "" then
        sum = sum + 1
        using_movies[sum - 1] = { path = movies[i], idx = i }
    end
end

-- 画面サイズの横と縦を変数に代入
local w,h = obj.screen_w,obj.screen_h

-- 描画先を仮想バッファに指定
obj.setoption("drawtarget","tempbuffer",w,h)

-- 本処理
if sum ~= 0 then
    -- 各動画の位置とサイズを格納するテーブル
    local rects = {}
    
    if arrangement == 0 then
        -- 0: 交互に並べる
        local cols, rows
        if sum <= 1 then
            cols, rows = 1, 1
        elseif sum == 2 then
            cols, rows = 2, 1
        elseif sum <= 4 then
            cols, rows = 2, 2
        elseif sum <= 6 then
            cols, rows = 3, 2
        else
            cols, rows = 3, 3
        end
        
        local cell_w = w / cols
        local cell_h = h / rows
        for i = 1, sum do
            local c = (i - 1) % cols
            local r = math.floor((i - 1) / cols)
            rects[i] = {
                x = -w/2 + (c + 0.5) * cell_w,
                y = -h/2 + (r + 0.5) * cell_h,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 1 then
        -- 1: 横に並べる
        local cell_w = w / sum
        local cell_h = h
        for i = 1, sum do
            rects[i] = {
                x = -w/2 + (i - 0.5) * cell_w,
                y = 0,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 2 then
        -- 2: 縦に並べる
        local cell_w = w
        local cell_h = h / sum
        for i = 1, sum do
            rects[i] = {
                x = 0,
                y = -h/2 + (i - 0.5) * cell_h,
                w = cell_w,
                h = cell_h
            }
        end
    elseif arrangement == 3 then
        -- 3: 1つ目縦いっぱい残り横
        if sum <= 1 then
            rects[1] = { x = 0, y = 0, w = w, h = h }
        else
            rects[1] = { x = -w/4, y = 0, w = w/2, h = h }
            local rem = sum - 1
            local cell_w = w / 2
            local cell_h = h / rem
            for i = 2, sum do
                rects[i] = {
                    x = w/4,
                    y = -h/2 + (i - 1.5) * cell_h,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 4 then
        -- 4: 1つ目横いっぱい残り横
        if sum <= 1 then
            rects[1] = { x = 0, y = 0, w = w, h = h }
        else
            rects[1] = { x = 0, y = -h/4, w = w, h = h/2 }
            local rem = sum - 1
            local cell_w = w / rem
            local cell_h = h / 2
            for i = 2, sum do
                rects[i] = {
                    x = -w/2 + (i - 1.5) * cell_w,
                    y = h/4,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 5 then
        -- 5: 2つ目まで縦いっぱい残り横
        if sum <= 2 then
            local cell_w = w / 2
            rects[1] = { x = -w/4, y = 0, w = cell_w, h = h }
            rects[2] = { x = w/4, y = 0, w = cell_w, h = h }
        else
            rects[1] = { x = -w/3, y = 0, w = w/3, h = h }
            rects[2] = { x = 0, y = 0, w = w/3, h = h }
            local rem = sum - 2
            local cell_w = w / 3
            local cell_h = h / rem
            for i = 3, sum do
                rects[i] = {
                    x = w/3,
                    y = -h/2 + (i - 2.5) * cell_h,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    elseif arrangement == 6 then
        -- 6: 2つ目まで横いっぱい残り横
        if sum <= 2 then
            local cell_h = h / 2
            rects[1] = { x = 0, y = -h/4, w = w, h = cell_h }
            rects[2] = { x = 0, y = h/4, w = w, h = cell_h }
        else
            rects[1] = { x = 0, y = -h/3, w = w, h = h/3 }
            rects[2] = { x = 0, y = 0, w = w, h = h/3 }
            local rem = sum - 2
            local cell_w = w / rem
            local cell_h = h / 3
            for i = 3, sum do
                rects[i] = {
                    x = -w/2 + (i - 2.5) * cell_w,
                    y = h/3,
                    w = cell_w,
                    h = cell_h
                }
            end
        end
    end

    -- 分割ラインを避ける処理
    if line_avoid == 1 and (line ~= 0 or line_w ~= 0 or line_h ~= 0) then
        local lw = line + line_w
        local lh = line + line_h
        local margin = 0.01
        for i = 1, sum do
            local r = rects[i]
            local left = r.x - r.w / 2
            local right = r.x + r.w / 2
            local top = r.y - r.h / 2
            local bottom = r.y + r.h / 2
            
            if left > -w/2 + margin then
                left = left + lw / 2
            end
            if right < w/2 - margin then
                right = right - lw / 2
            end
            if top > -h/2 + margin then
                top = top + lh / 2
            end
            if bottom < h/2 - margin then
                bottom = bottom - lh / 2
            end
            
            r.w = math.max(0, right - left)
            r.h = math.max(0, bottom - top)
            r.x = left + r.w / 2
            r.y = top + r.h / 2
        end
    end

    -- 動画のロードと描画
    for i = 1, sum do
        local movie_info = using_movies[i - 1]
        local idx = movie_info.idx
        local filepath = movie_info.path
        
        local start_sec = start_seconds_list[idx] or 0
        local start_frm = start_frames_list[idx] or 0
        local end_sec = end_seconds_list[idx] or 0
        local end_frm = end_frames_list[idx] or 0
        local speed_pct = movie_speeds_list[idx] or 100
        local is_loop = loops_list[idx] or 0
        
        local start_pos = start_sec + (start_frm / obj.framerate)
        local end_pos = end_sec + (end_frm / obj.framerate)
        
        -- 仮ロードして総時間を取得
        local total_time = obj.load("movie", filepath, start_pos)
        
        -- 有効な再生範囲（秒）の決定
        local duration = 0
        if end_pos > start_pos then
            duration = end_pos - start_pos
        elseif total_time and total_time > start_pos then
            duration = total_time - start_pos
        end
        
        -- ロード位置の計算
        local elapsed = obj.time * (speed_pct / 100)
        local time_to_load = start_pos
        
        if duration > 0 then
            if is_loop == 1 then
                time_to_load = start_pos + (elapsed % duration)
            else
                time_to_load = start_pos + math.min(elapsed, duration)
            end
        else
            time_to_load = start_pos + elapsed
        end
        
        -- 本ロード
        obj.load("movie", filepath, time_to_load)
        local org_w, org_h = obj.w, obj.h
        
        -- クリッピング量の算出 (一律削減 / 2 + 個別削減。上限100)
        local clip_l_px = org_w * (math.min(100, (common_lr / 2) + clip_l) / 100)
        local clip_r_px = org_w * (math.min(100, (common_lr / 2) + clip_r) / 100)
        local clip_u_px = org_h * (math.min(100, (common_ub / 2) + clip_u) / 100)
        local clip_d_px = org_h * (math.min(100, (common_ub / 2) + clip_d) / 100)
        
        obj.effect("クリッピング", 
            "上", clip_u_px, 
            "下", clip_d_px, 
            "左", clip_l_px, 
            "右", clip_r_px, 
            "中心の位置を変更", 0
        )
        
        local target_w = rects[i].w
        local target_h = rects[i].h
        
        local new_w, new_h
        if fill == 1 then
            new_w = target_w
            new_h = target_h
        else
            local scale_w = 1 - ((clip_l_px + clip_r_px) / org_w)
            local scale_h = 1 - ((clip_u_px + clip_d_px) / org_h)
            new_w = target_w * scale_w
            new_h = target_h * scale_h
        end
        
        obj.effect("リサイズ", 
            "拡大率", 100.000, 
            "X", new_w, 
            "Y", new_h, 
            "補間なし", 0, 
            "ピクセル数でサイズ指定", 1
        )
        
        obj.draw(rects[i].x, rects[i].y)
    end

    -- 分割ラインの描画
    if line ~= 0 or line_w ~= 0 or line_h ~= 0 then
        local function draw_line(lx, ly, lw, lh)
            obj.load("figure", "四角形", line_col, 100)
            obj.effect("リサイズ", 
                "拡大率", 100.000, 
                "X", lw, 
                "Y", lh, 
                "補間なし", 0, 
                "ピクセル数でサイズ指定", 1
            )
            obj.draw(lx, ly)
        end

        if arrangement == 0 then
            local cols, rows
            if sum <= 1 then
                cols, rows = 1, 1
            elseif sum == 2 then
                cols, rows = 2, 1
            elseif sum <= 4 then
                cols, rows = 2, 2
            elseif sum <= 6 then
                cols, rows = 3, 2
            else
                cols, rows = 3, 3
            end
            local cell_w = w / cols
            local cell_h = h / rows
            for c = 1, cols - 1 do
                draw_line(-w/2 + c * cell_w, 0, line + line_w, h)
            end
            for r = 1, rows - 1 do
                draw_line(0, -h/2 + r * cell_h, w, line + line_h)
            end
        elseif arrangement == 1 then
            local cell_w = w / sum
            for c = 1, sum - 1 do
                draw_line(-w/2 + c * cell_w, 0, line + line_w, h)
            end
        elseif arrangement == 2 then
            local cell_h = h / sum
            for r = 1, sum - 1 do
                draw_line(0, -h/2 + r * cell_h, w, line + line_h)
            end
        elseif arrangement == 3 then
            if sum >= 2 then
                draw_line(0, 0, line + line_w, h)
                local rem = sum - 1
                local cell_h = h / rem
                for r = 1, rem - 1 do
                    draw_line(w/4, -h/2 + r * cell_h, w/2, line + line_h)
                end
            end
        elseif arrangement == 4 then
            if sum >= 2 then
                draw_line(0, 0, w, line + line_h)
                local rem = sum - 1
                local cell_w = w / rem
                for c = 1, rem - 1 do
                    draw_line(-w/2 + c * cell_w, h/4, line + line_w, h/2)
                end
            end
        elseif arrangement == 5 then
            if sum >= 3 then
                draw_line(-w/6, 0, line + line_w, h)
                draw_line(w/6, 0, line + line_w, h)
                local rem = sum - 2
                local cell_h = h / rem
                for r = 1, rem - 1 do
                    draw_line(w/3, -h/2 + r * cell_h, w/3, line + line_h)
                end
            end
        elseif arrangement == 6 then
            if sum >= 3 then
                draw_line(0, -h/6, w, line + line_h)
                draw_line(0, h/6, w, line + line_h)
                local rem = sum - 2
                local cell_w = w / rem
                for c = 1, rem - 1 do
                    draw_line(-w/2 + c * cell_w, h/3, line + line_w, h/3)
                end
            end
        end
    end

    obj.setoption("drawtarget","framebuffer")
    obj.load("tempbuffer")
    return
else
    obj.setoption("drawtarget","framebuffer")
    obj.load("tempbuffer")
    return
end